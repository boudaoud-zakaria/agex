# Copy to .env (Dokploy: paste into the app's Environment tab; it writes .env for docker compose)

# Public site URL, used for metadata, sitemap and robots (applied at build time)
NEXT_PUBLIC_SITE_URL=https://agextech.com

# Optional: HTTPS endpoint (CRM / email webhook) that receives each inquiry as JSON.
# Inquiries are always saved to /app/data/submissions.jsonl (submissions_data volume).
CONTACT_WEBHOOK_URL=
