# Copy to .env (Dokploy: paste into the app's Environment tab; it writes .env for docker compose).
# Never commit .env — it holds credentials.

# Public site URL, used for metadata, sitemap and robots (applied at build time)
NEXT_PUBLIC_SITE_URL=https://agextech.com

# Contact form email delivery (Mailgun HTTP API)
# MAILGUN_API_KEY: a Domain Sending Key (Mailgun → Sending → Domain settings → Sending keys), not the account API key.
# EU-region domains use MAILGUN_API_BASE=https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=agextech.com
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_FROM="AGEX Website <no-reply@agextech.com>"
# /contact (mobility business inquiries) and /contact/investors (investors & partners)
CONTACT_TO_CUSTOMER=dev@agextech.com
CONTACT_TO_INVESTOR=investor@agextech.com

# Optional: HTTPS endpoint (CRM / webhook) that also receives each inquiry as JSON.
# Every inquiry is always saved to /app/data/submissions.jsonl (submissions_data volume).
CONTACT_WEBHOOK_URL=
